{
  "name": "dsh-mobile-drawer",
  "version": "0.1.2",
  "description": "「DSH·手机适配」：窄屏下把侧栏收起为悬浮小方块，点会话自动收起，并压掉切会话时的自动聚焦，避免软键盘顶起页面。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-er/dsh-mobile-drawer.git"
  },
  "author": "betterer",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "docs/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@types/node": "^22.20.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
